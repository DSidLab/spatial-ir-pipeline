nextflow_pipeline {

    name "Test full workflow"
    script "../main.nf"
    tag "pipeline_full"
    profile "test"

    config "conf/test.config"

    test("Full pipeline test") {

        when {
            params {
                input = "$baseDir/tests/data/samples_full.csv"
                outdir = "$outputDir"
            }
        }

        then {
            def stable_out_files = getAllFilesFromDir(params.outdir, false, ['**/bootstrap*', '**/quarto*', 'pipeline_info/*', '**/*fastq.gz'], null, ['*'])

            assertAll(
                { assert workflow.success },
                { assert snapshot(stable_out_files*.name).match() }
            )
        }
    }
}
